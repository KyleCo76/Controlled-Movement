@wrapMethod(CR4IngameMenu)
function SU_onMenuEntered(menu : string, out descriptors : array<SU_MenuDescriptor>)
{
    wrappedMethod(menu, descriptors);
    // Register on actual settings pages; the parent folder need not emit entry.
    if (menu == "cm_general" || menu == "cm_steps" || menu == "cm_true_steps"
        || menu == "cm_fluid_controls" || menu == "cm_fluid_movement"
        || menu == "cm_roach_general" || menu == "cm_roach_steps" || menu == "cm_roach_true_steps"
        || menu == "cm_roach_fluid_movement" || menu == "cm_controls" || menu == "cm_swim_general"
        || menu == "cm_swim_speeds" || menu == "cm_swim_true_steps")
    {
        descriptors.PushBack(new CWS_MenuDescriptor in this);
    }
}
